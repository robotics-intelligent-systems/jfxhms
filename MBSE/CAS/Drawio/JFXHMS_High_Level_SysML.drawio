ned&#10;Approve module load/CG and services; inspect installed arrangement and replacement access." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="120" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-MOD-02" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-MOD-02" target="MOD-02"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-MOD-02" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-MOD-02" target="MOD-02"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-MOD-03" value="«block» mission&#10;Asset: MOD&#10;Proposed allocation&#10;CAD: helipad" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="370" width="350" height="210" as="geometry" /></mxCell><mxCell id="MOD-03" value="«requirement» MOD-03&#10;Helipad interface&#10;SHALL treat the illustrated helipad as a separately engineered medevac/logistics interface with aircraft loads, clearances and operating limits." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="370" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-MOD-03" value="«testCase» MOD-03-EV&#10;Method: A/I — planned&#10;Approve aircraft/platform compatibility, structural/environment limits and authorized operating procedures before activation." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="370" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-MOD-03" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-MOD-03" target="MOD-03"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-MOD-03" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-MOD-03" target="MOD-03"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-MOD-04" value="«block» mission&#10;Asset: MOD&#10;Proposed allocation&#10;CAD: rescue/support boats and crane" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="620" width="350" height="210" as="geometry" /></mxCell><mxCell id="MOD-04" value="«requirement» MOD-04&#10;Rescue/support boats&#10;SHALL define stowage, handling, launching/recovery and safe patient-transfer interfaces for selected support boats." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="620" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-MOD-04" value="«testCase» MOD-04-EV&#10;Method: A/D — planned&#10;Review handling/load/exclusion plan and demonstrate authorized recovery/transfer under defined conditions." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="620" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-MOD-04" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-MOD-04" target="MOD-04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-MOD-04" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-MOD-04" target="MOD-04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-MOD-05" value="«block» energy&#10;Asset: MOD&#10;Proposed allocation&#10;CAD: hybrid propulsion and solar" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="870" width="350" height="210" as="geometry" /></mxCell><mxCell id="MOD-05" value="«requirement» MOD-05&#10;Hybrid and solar option&#10;SHALL define the selected hybrid propulsion/energy arrangement and roof PV without inferring a fuel chemistry from the illustration." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="870" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-MOD-05" value="«testCase» MOD-05-EV&#10;Method: A/T — planned&#10;Approve drive/source selection and energy/thermal/load analysis; demonstrate source fault and essential-load response." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="870" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-MOD-05" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-MOD-05" target="MOD-05"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-MOD-05" value="«verify»&#10;planne