: modular facilities and advanced care panel" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="620" width="350" height="210" as="geometry" /></mxCell><mxCell id="SHIP-02" value="«requirement» SHIP-02&#10;Advanced clinical facilities&#10;SHALL evaluate illustrated emergency, surgery, ICU, laboratory, pharmacy, maternity and telemedicine facilities as separately approved clinical modules." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="620" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-SHIP-02" value="«testCase» SHIP-02-EV&#10;Method: A/I — planned&#10;Approve clinical scope, staff/equipment, layout, utilities and qualification evidence for each activated service." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="620" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-SHIP-02" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-SHIP-02" target="SHIP-02"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-SHIP-02" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-SHIP-02" target="SHIP-02"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-SHIP-03" value="«block» medical&#10;Asset: SHIP&#10;Proposed allocation&#10;CAD: patient accommodation" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="870" width="350" height="210" as="geometry" /></mxCell><mxCell id="SHIP-03" value="«requirement» SHIP-03&#10;Patient accommodation&#10;SHALL define configurable accommodation, transfers, accessibility and evacuation routes matched to approved occupancy and clinical scope." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="870" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-SHIP-03" value="«testCase» SHIP-03-EV&#10;Method: I/D — planned&#10;Inspect arrangement and demonstrate representative transfer/egress against a clinically reviewed plan." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="870" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-SHIP-03" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-SHIP-03" target="SHIP-03"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-SHIP-03" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-SHIP-03" target="SHIP-03"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-SHIP-04" value="«block» control&#10;Asset: SHIP&#10;Proposed allocation&#10;CAD: bridge and command center" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="1120" width="350" height="210" as="geometry" /></mxCell><mxCell id="SHIP-04" value="«requirement» SHIP-04&#10;Bridge and command&#10;SHALL provide local navigation, communications and mission coordination under defined bridge and clinical responsibilities." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="1120" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-SHIP-04" value="«testCase» SHIP-04-EV&#10;Method: T/D — planned&#10;Demonstrate operational coordination and control continuity under sensor/link faults using an approved responsibility table." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="1120" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-SHIP-04" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-SHIP-04" target="SHIP-04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-SHIP-04" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-SHIP-04" target="SHIP-04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-SHIP-05" value="«block» mission&#10;Asset: SHIP&#10;Proposed allocation&#10;CAD: logistics/cargo and humanitarian panel" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="1370" width="350" height="210" as="geometry" /></mxCell><mxCell id="SHIP-05" value="«requirement» SHIP-05&#10;Logistics and cargo&#10;SHALL define modular cargo, supplies and vehicle/container interfaces with retention, loading records and cold-chain/expiry controls where applicable." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="1370" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-SHIP-05" value="«testCase» SHIP-05-EV&#10;Method: A/I — planned&#10;Verify cargo mass/CG, retention and records; inspect cold-chain/expiry acceptance for selected supplies." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="1370" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-SHIP-05" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-SHIP-05" target="SHIP-05"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-SHIP-05" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-SHIP-05" target="SHIP-05"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="view-11" name="12 REQ — allocation 43–46"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="req [JFXHMS] — proposed satisfy and planned verify relations&#10;PROPOSED DESIGN / EVIDENCE PENDING" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1540" height="70" as="geometry" /></mxCell><mxCell id="design-SHIP-06" value="«block» mission&#10;Asset: SHIP&#10;Proposed allocation&#10;CAD: helipad and rescue/support boats" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="350" height="210" as="geometry" /></mxCell><mxCell id="SHIP-06" value="«requirement» SHIP-06&#10;Helipad and support boats&#10;SHALL engineer independent helipad and boat handling/transfer interfaces with approved loads, access, exclusion zones and operating limits." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="120" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-SHIP-06" value="«testCase» SHIP-06-EV&#10;Method: A/D — planned&#10;Approve aircraft/boat compatibility and handling plans; demonstrate only operations whose entry criteria are satisfied." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="120" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-SHIP-06" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-SHIP-06" target="SHIP-06"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-SHIP-06" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-SHIP-06" target="SHIP-06"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-SHIP-07" value="«block» energy&#10;Asset: SHIP&#10;Proposed allocation&#10;CAD: hybrid propulsion and solar" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="370" width="350" height="210" as="geometry" /></mxCell><mxCell id="SHIP-07" value="«requirement» SHIP-07&#10;Energy variants and renewables&#10;SHALL assess illustrated LNG/biofuel/electric-ready propulsion alternatives and PV against mission demand and essential reserves." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="370" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-SHIP-07" value="«testCase» SHIP-07-EV&#10;Method: A/T — planned&#10;Record selected sources and their mass/thermal/energy impacts; verify reserve and fault behavior without claiming all variants are installed." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="370" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-SHIP-07" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-SHIP-07" target="SHIP-07"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-SHIP-07" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-SHIP-07" target="SHIP-07"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-SHIP-08" value="«block» medical&#10;Asset: SHIP&#10;Proposed allocation&#10;CAD: water and waste systems" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="620" width="350" height="210" as="geometry" /></mxCell><mxCell id="SHIP-08" value="«requirement» SHIP-08&#10;Water and waste plant&#10;SHALL define filtration/desalination/treatment candidates and separate potable, process and waste interfaces for mission/hotel/clinical demand." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="620" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-SHIP-08" value="«testCase» SHIP-08-EV&#10;Method: A/T — planned&#10;Approve source/quality/capacity and discharge criteria; verify selected process and service access against the defined specification." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="620" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-SHIP-08" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-SHIP-08" target="SHIP-08"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-SHIP-08" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-SHIP-08" target="SHIP-08"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-SHIP-09" value="«block» clinical&#10;Asset: SHIP&#10;Proposed allocation&#10;CAD: HL7 FHIR, DICOM, OGC/OSM examples" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="870" width="350" height="210" as="geometry" /></mxCell><mxCell id="SHIP-09" value="«requirement» SHIP-09&#10;Clinical and mission exchange&#10;SHALL select authorized FHIR, optional DICOM imaging and mission/geospatial adapters with explicit versions, profiles and permissions." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="870" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-SHIP-09" value="«testCase» SHIP-09-EV&#10;Method: T — planned&#10;Run authorized synthetic clinical/imaging/mission exchange tests; verify invalid-profile rejection and privacy separation." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="870" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-SHIP-09" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-SHIP-09" target="SHIP-09"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-SHIP-09" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-SHIP-09" target="SHIP-09"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>