ometry" /></mxCell><mxCell id="PAT-03" value="«requirement» PAT-03&#10;Patient compartment&#10;SHALL provide an arranged patient area for stretcher retention, selected monitoring and supervised telemedicine with accessible equipment.&#10;External concept baseline: JFXAI4CBS" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4cbs/blob/main/docs/requirements/transferred-platform-concepts.md"><mxGeometry x="550" y="120" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-PAT-03" value="«testCase» PAT-03-EV&#10;Method: I/D — planned&#10;Inspect stretcher/equipment access and demonstrate transfer and monitoring workflow for approved occupancy.&#10;External concept baseline: JFXAI4CBS" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4cbs/blob/main/docs/requirements/transferred-platform-concepts.md"><mxGeometry x="1220" y="120" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-PAT-03" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-PAT-03" target="PAT-03"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-PAT-03" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-PAT-03" target="PAT-03"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-PAT-04" value="«block» mission&#10;Asset: PAT&#10;Proposed allocation&#10;CAD: modular deck&#10;External concept baseline: JFXAI4CBS" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4cbs/blob/main/docs/requirements/transferred-platform-concepts.md"><mxGeometry x="30" y="370" width="350" height="210" as="geometry" /></mxCell><mxCell id="PAT-04" value="«requirement» PAT-04&#10;Modular working deck&#10;SHALL define deck equipment/rescue/cargo mounts, retention and clear working/boarding routes with controlled mass/CG.&#10;External concept baseline: JFXAI4CBS" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4cbs/blob/main/docs/requirements/transferred-platform-concepts.md"><mxGeometry x="550" y="370" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-PAT-04" value="«testCase» PAT-04-EV&#10;Method: A/I — planned&#10;Review load/mount records and inspect access for each selected rescue/cargo configuration.&#10;External concept baseline: JFXAI4CBS" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4cbs/blob/main/docs/requirements/transferred-platform-concepts.md"><mxGeometry x="1220" y="370" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-PAT-04" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-PAT-04" target="PAT-04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-PAT-04" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-PAT-04" target="PAT-04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-PAT-05" value="«block» energy&#10;Asset: PAT&#10;Proposed allocation&#10;CAD: solar panels&#10;External concept baseline: JFXAI4CBS" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4cbs/blob/main/docs/requirements/transferred-platform-concepts.md"><mxGeometry x="30" y="620" width="350" height="210" as="geometry" /></mxCell><mxCell id="PAT-05" value="«requirement» PAT-05&#10;Solar and protected power&#10;SHALL define roof PV and its protected conversion interface to the selected vessel energy system.&#10;External concept baseline: JFXAI4CBS" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4cbs/blob/main/docs/requirements/transferred-platform-concepts.md"><mxGeometry x="550" y="620" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-PAT-05" value="«testCase» PAT-05-EV&#10;Method: A/T — planned&#10;Approve mounting/shading and power budget; test isolated charging and essential-load priority.&#10;External concept baseline: JFXAI4CBS" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4cbs/blob/main/docs/requirements/transferred-platform-concepts.md"><mxGeometry x="1220" y="620" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-PAT-05" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-PAT-05" target="PAT-05"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-PAT-05" value="«verify»&#10