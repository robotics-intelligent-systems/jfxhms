=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;dashed=0;" edge="1" parent="1" source="gate0" target="gate1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="next1" value="[gate accepted]" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;dashed=0;" edge="1" parent="1" source="gate1" target="gate2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="next2" value="[gate accepted]" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;dashed=0;" edge="1" parent="1" source="gate2" target="gate3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="next3" value="[gate accepted]" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;dashed=0;" edge="1" parent="1" source="gate3" target="gate4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="next4" value="[gate accepted]" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;dashed=0;" edge="1" parent="1" source="gate4" target="gate5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="failure" value="Failure / missing evidence:&#10;Hold release, record issue, correct and repeat affected gate.&#10;No automatic pass from simulation or diagram coverage." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="320" height="260" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="view-4" name="05 REQ — allocation 1–6"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="req [JFXHMS] — proposed satisfy and planned verify relations&#10;PROPOSED DESIGN / EVIDENCE PENDING" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1540" height="70" as="geometry" /></mxCell><mxCell id="design-HMS-001" value="«block» configuration&#10;Asset: SYS&#10;Proposed allocation&#10;Platform-derived requirement; not inferred from CAD" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="350" height="210" as="geometry" /></mxCell><mxCell id="HMS-001" value="«requirement» HMS-001&#10;Configuration and service scope&#10;The system SHALL record approved facility, fleet, clinical-service and integration configurations with versioned identities and accountable roles." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="120" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-HMS-001" value="«testCase» HMS-001-EV&#10;Method: I — planned&#10;Review one configuration and reject a module whose required interface or approval record is absent." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="120" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-HMS-001" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-HMS-001" target="HMS-001"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-HMS-001" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-HMS-001" target="HMS-001"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-HMS-002" value="«block» clinical&#10;Asset: SYS&#10;Proposed allocation&#10;Platform-derived requirement; not inferred from CAD" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="370" width="350" height="210" as="geometry" /></mxCell><mxCell id="HMS-002" value="«requirement» HMS-002&#10;Clinical workflow&#10;The system SHALL support authorized registration, encounter, result review and handover with explicit responsible practitioners and workflow states." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="370" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-HMS-002" value="«testCase» HMS-002-EV&#10;Method: T/D — planned&#10;Complete a synthetic encounter; reject invalid transitions and retain practitioner identity and reviewed result history." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="370" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-HMS-002" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-HMS-002" target="HMS-002"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-HMS-002" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-HMS-002" target="HMS-002"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-HMS-003" value="«block» clinical&#10;Asset: SYS&#10;Proposed allocation&#10;Platform-derived requirement; not inferred from CAD" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="620" width="350" height="210" as="geometry" /></mxCell><mxCell id="HMS-003" value="«requirement» HMS-003&#10;Clinical interoperability&#10;The system SHALL declare selected FHIR versions, profiles, terminology and optional imaging adapters and validate incoming exchanges." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="620" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-HMS-003" value="«testCase» HMS-003-EV&#10;Method: T — planned&#10;Accept selected-profile synthetic messages; reject invalid or unauthorized messages with traceable outcomes." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="620" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-HMS-003" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-HMS-003" target="HMS-003"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-HMS-003" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-HMS-003" target="HMS-003"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-HMS-004" value="«block» clinical&#10;Asset: SYS&#10;Proposed allocation&#10;Platform-derived requirement; not inferred from CAD" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="870" width="350" height="210" as="geometry" /></mxCell><mxCell id="HMS-004" value="«requirement» HMS-004&#10;Access and audit&#10;The system SHALL enforce role and purpose scoped access at clinical APIs and audit authorized and denied access without copying clinical content into fleet telemetry." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="870" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-HMS-004" value="«testCase» HMS-004-EV&#10;Method: T — planned&#10;Deny an unauthorized synthetic record request; log subject, action, outcome and time; inspect operational events for prohibited clinical fields." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="870" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-HMS-004" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-HMS-004" target="HMS-004"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-HMS-004" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-HMS-004" target="HMS-004"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-HMS-005" value="«block» operations&#10;Asset: SYS&#10;Proposed allocation&#10;Platform-derived requirement; not inferred from CAD" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="1120" width="350" height="210" as="geometry" /></mxCell><mxCell id="HMS-005" value="«requirement» HMS-005&#10;Hospital and supply operations&#10;The system SHALL track bed, equipment, inventory and selected supply-chain transitions with revision checks and traceable lot/expiry records where applicable." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="1120" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-HMS-005" value="«testCase» HMS-005-EV&#10;Method: T — planned&#10;Reject an outdated revision; reconcile synthetic reservation/release and lot/expiry events without duplicate stock movements." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="1120" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-HMS-005" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-HMS-005" target="HMS-005"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-HMS-005" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-HMS-005" target="HMS-005"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-HMS-006" value="«block» dispatch&#10;Asset: SYS&#10;Proposed allocation&#10;Platform-derived requirement; not inferred from CAD" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="1370" width="350" height="210" as="geometry" /></mxCell><mxCell id="HMS-006" value="«requirement» HMS-006&#10;Supervised EMS coordination&#10;The system SHALL coordinate incident, availability, assignment, transport and handover under qualified dispatch authority, with review before consequential assignment." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="1370" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-HMS-006" value="«testCase» HMS-006-EV&#10;Method: T/D — planned&#10;Replay a synthetic incident through handover; reject an unreviewed assignment and detect an unavailable resource." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="1370" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-HMS-006" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-HMS-006" target="HMS-006"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-HMS-006" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-HMS-006" target="HMS-006"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="view-5" name="06 REQ — allocation 7–12"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="req [JFXHMS] — proposed satisfy and planned verify relations&#10;PROPOSED DESIGN / EVIDENCE PENDING" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1540" height="70" as="geometry" /></mxCell><mxCell id="design-HMS-007" value="«block» edge&#10;Asset: SYS&#10;Proposed allocation&#10;Platform-derived requirement; not inferred from CAD" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="350" height="210" as="geometry" /></mxCell><mxCell id="HMS-007" value="«requirement» HMS-007&#10;Operational twin contract&#10;The system SHALL expose versioned asset/configuration identity, timestamp, units, quality, readiness and fault state through a separate operational data contract." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="120" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-HMS-007" value="«testCase» HMS-007-EV&#10;Method: T — planned&#10;Replay valid, malformed and stale telemetry; validate provenance, mark stale state and preserve clinical-data isolation." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="120" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-HMS-007" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-HMS-007" target="HMS-007"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-HMS-007" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-HMS-007" target="HMS-007"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-HMS-008" value="«block» edge&#10;Asset: SYS&#10;Proposed allocation&#10;Platform-derived requirement; not inferred from CAD" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="370" width="350" height="210" as="geometry" /></mxCell><mxCell id="HMS-008" value="«requirement» HMS-008&#10;Disconnected recovery&#10;The system SHALL define local workflows, buffering, idempotent replay and conflict resolution for loss and restoration of selected external links." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="370" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-HMS-008" value="«testCase» HMS-008-EV&#10;Method: T — planned&#10;Replay duplicate and out-of-order events after simulated WAN loss; preserve identity and expose unresolved conflicts for authorized review." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="370" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-HMS-008" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-HMS-008" target="HMS-008"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-HMS-008" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-HMS-008" target="HMS-008"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-HMS-009" value="«block» decision&#10;Asset: SYS&#10;Proposed allocation&#10;Platform-derived requirement; not inferred from CAD" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="620" width="350" height="210" as="geometry" /></mxCell><mxCell id="HMS-009" value="«requirement» HMS-009&#10;Governed decision support&#10;The system SHALL label AI/CQL outputs as proposals with input/model/rule version and authorized human disposition; local helm and clinical authority SHALL remain independent of cloud availability." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="620" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-HMS-009" value="«testCase» HMS-009-EV&#10;Method: T/I — planned&#10;Reject an unreviewed consequential proposal; retrieve provenance and reviewer disposition; demonstrate continued local authority during AI/link loss." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="620" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-HMS-009" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-HMS-009" target="HMS-009"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-HMS-009" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-HMS-009" target="HMS-009"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-HMS-010" value="«block» configuration&#10;Asset: SYS&#10;Proposed allocation&#10;Platform-derived requirement; not inferred from CAD" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="870" width="350" height="210" as="geometry" /></mxCell><mxCell id="HMS-010" value="«requirement» HMS-010&#10;Verification and change control&#10;The system SHALL link each requirement to configuration, proposed design allocation, verification procedure, result and change impact before release." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="870" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-HMS-010" value="«testCase» HMS-010-EV&#10;Method: I/T — planned&#10;Inspect full requirement coverage; reject release when required evidence, critical budgets or approved dispositions are missing." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="870" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-HMS-010" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-HMS-010" target="HMS-010"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-HMS-010" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-HMS-010" target="HMS-010"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-MED-C01" value="«block» hull&#10;Asset: COM&#10;Proposed allocation&#10;All CAD: hull and modular arrangements" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="1120" width="350" height="210" as="geometry" /></mxCell><mxCell id="MED-C01" value="«requirement» MED-C01&#10;Naval loading and stability&#10;SHALL define displacement, draft, freeboard, mass/CG and stability for each approved occupancy and module loading case." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="1120" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-MED-C01" value="«testCase» MED-C01-EV&#10;Method: A — planned&#10;Approved loading-case analysis against preselected naval criteria; no dimensions inferred from the illustration." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="1120" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-MED-C01" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-MED-C01" target="MED-C01"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-MED-C01" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-MED-C01" target="MED-C01"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-MED-C02" value="«block» hull&#10;Asset: COM&#10;Proposed allocation&#10;All CAD: hull, deck and equipment" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="1370" width="350" height="210" as="geometry" /></mxCell><mxCell id="MED-C02" value="«requirement» MED-C02&#10;Structure and watertightness&#10;SHALL define compartmentation, penetrations, structural load paths, module attachments, drainage and corrosion protection." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="1370" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-MED-C02" value="«testCase» MED-C02-EV&#10;Method: A/I — planned&#10;Inspect arrangement and review structural/penetration/load evidence for each selected configuration." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="1370" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-MED-C02" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-MED-C02" target="MED-C02"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-MED-C02" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-MED-C02" target="MED-C02"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="view-6" name="07 REQ — allocation 13–18"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="req [JFXHMS] — proposed satisfy and planned verify relations&#10;PROPOSED DESIGN / EVIDENCE PENDING" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1540" height="70" as="geometry" /></mxCell><mxCell id="design-MED-C03" value="«block» medical&#10;Asset: COM&#10;Proposed allocation&#10;All CAD: patient facilities and access" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="350" height="210" as="geometry" /></mxCell><mxCell id="MED-C03" value="«requirement» MED-C03&#10;Patient access and transfer&#10;SHALL define secure stretcher/equipment retention, boarding, handling, access and emergency egress for the approved occupancy." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="120" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-MED-C03" value="«testCase» MED-C03-EV&#10;Method: I/D — planned&#10;Demonstrate representative boarding, securing and egress against an approved human-factors plan." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="120" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-MED-C03" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-MED-C03" target="MED-C03"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-MED-C03" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-MED-C03" target="MED-C03"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-MED-C04" value="«block» energy&#10;Asset: COM&#10;Proposed allocation&#10;All CAD: energy systems; derived resilience" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="370" width="350" height="210" as="geometry" /></mxCell><mxCell id="MED-C04" value="«requirement» MED-C04&#10;Essential energy&#10;SHALL define protected power, reserve and degraded-load priorities for navigation, medical support, communications and alarms." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="370" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-MED-C04" value="«testCase» MED-C04-EV&#10;Method: A/T — planned&#10;Review mission energy budget; inject source loss and verify approved essential-load and shutdown behavior." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="370" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-MED-C04" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-MED-C04" target="MED-C04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-MED-C04" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-MED-C04" target="MED-C04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-MED-C05" value="«block» medical&#10;Asset: COM&#10;Proposed allocation&#10;All CAD: medical facilities and water/waste" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="620" width="350" height="210" as="geometry" /></mxCell><mxCell id="MED-C05" value="«requirement» MED-C05&#10;Medical environment and utilities&#10;SHALL define clean/dirty flows, ventilation, potable/process water, waste and equipment-service access for the selected medical mission." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="620" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-MED-C05" value="«testCase» MED-C05-EV&#10;Method: A/I — planned&#10;Approve layout, segregation, utility budgets and maintainability criteria before installation." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="620" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-MED-C05" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-MED-C05" target="MED-C05"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-MED-C05" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-MED-C05" target="MED-C05"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-MED-C06" value="«block» configuration&#10;Asset: COM&#10;Proposed allocation&#10;All CAD: modular design and open interfaces" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="870" width="350" height="210" as="geometry" /></mxCell><mxCell id="MED-C06" value="«requirement» MED-C06&#10;Module interfaces&#10;SHALL maintain versioned mounting, mass/CG, power/fluid, command/data and service contracts with compatibility and license records." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="870" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-MED-C06" value="«testCase» MED-C06-EV&#10;Method: I — planned&#10;Review a module contract and its approved installation/removal plan; identify all affected loading and service budgets." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="870" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-MED-C06" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-MED-C06" target="MED-C06"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-MED-C06" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-MED-C06" target="MED-C06"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-MED-C07" value="«block» clinical&#10;Asset: COM&#10;Proposed allocation&#10;README: FHIR/CQL; large-ship CAD: FHIR/DICOM" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="1120" width="350" height="210" as="geometry" /></mxCell><mxCell id="MED-C07" value="«requirement» MED-C07&#10;Interoperability scope&#10;SHALL select clinical exchange versions/profiles and terminology; isolate HIS/FHIR and optional imaging adapters behind validated interfaces." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="1120" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-MED-C07" value="«testCase» MED-C07-EV&#10;Method: T/I — planned&#10;Test representative exchanges against selected profiles and authorization rules; record incompatible or invalid inputs." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="1120" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-MED-C07" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-MED-C07" target="MED-C07"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-MED-C07" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-MED-C07" target="MED-C07"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-MED-C08" value="«block» clinical&#10;Asset: COM&#10;Proposed allocation&#10;README governance; derived privacy boundary" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="1370" width="350" height="210" as="geometry" /></mxCell><mxCell id="MED-C08" value="«requirement» MED-C08&#10;Clinical privacy boundary&#10;SHALL keep clinical records and access audit under dedicated governance; use authorized minimal links in ordinary asset/mission telemetry." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="1370" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-MED-C08" value="«testCase» MED-C08-EV&#10;Method: T — planned&#10;Attempt unauthorized clinical access/export through twin and event APIs; deny disclosure and audit authorized access." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="1370" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-MED-C08" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-MED-C08" target="MED-C08"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-MED-C08" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-MED-C08" target="MED-C08"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="view-7" name="08 REQ — allocation 19–24"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="req [JFXHMS] — proposed satisfy and planned verify relations&#10;PROPOSED DESIGN / EVIDENCE PENDING" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1540" height="70" as="geometry" /></mxCell><mxCell id="design-MED-C09" value="«block» edge&#10;Asset: COM&#10;Proposed allocation&#10;All CAD: digital twin dashboards" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="350" height="210" as="geometry" /></mxCell><mxCell id="MED-C09" value="«requirement» MED-C09&#10;OpenTwin asset data&#10;SHALL publish asset/configuration identity, mode, location, energy, equipment readiness, faults and maintenance with timestamps, units and quality." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="120" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-MED-C09" value="«testCase» MED-C09-EV&#10;Method: T — planned&#10;Replay valid, stale and reconnect datasets; verify field provenance, configuration and approved freshness/error criteria." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="120" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-MED-C09" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-MED-C09" target="MED-C09"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-MED-C09" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-MED-C09" target="MED-C09"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-MED-C10" value="«block» edge&#10;Asset: COM&#10;Proposed allocation&#10;All CAD: navigation, communications and telemedicine" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="370" width="350" height="210" as="geometry" /></mxCell><mxCell id="MED-C10" value="«requirement» MED-C10&#10;Communications resilience&#10;SHALL provide selected marine/local communications and authorized remote monitoring with buffering and defined disconnected workflows." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="370" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-MED-C10" value="«testCase» MED-C10-EV&#10;Method: T — planned&#10;Demonstrate WAN loss, reconnection and conflict handling while essential local monitoring/control remains available." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="370" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-MED-C10" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-MED-C10" target="MED-C10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-MED-C10" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-MED-C10" target="MED-C10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-MED-C11" value="«block» control&#10;Asset: COM&#10;Proposed allocation&#10;README human oversight; CAD AI assistance" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="620" width="350" height="210" as="geometry" /></mxCell><mxCell id="MED-C11" value="«requirement» MED-C11&#10;Local authority and AI governance&#10;SHALL retain validated local vessel control and qualified clinical/dispatch authority; record model, input provenance and human review for AI proposals." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="620" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-MED-C11" value="«testCase» MED-C11-EV&#10;Method: T/I — planned&#10;Block unreviewed consequential proposals; verify local safe stop/control during cloud/AI loss and retrieve reviewed decision evidence." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="620" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-MED-C11" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-MED-C11" target="MED-C11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-MED-C11" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-MED-C11" target="MED-C11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-MED-C12" value="«block» simulation&#10;Asset: COM&#10;Proposed allocation&#10;README MBSE; derived engineering gates" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="870" width="350" height="210" as="geometry" /></mxCell><mxCell id="MED-C12" value="«requirement» MED-C12&#10;Verification and envelope&#10;SHALL approve mission/environment, device/calibration and recovery criteria; validate models and staged trials before envelope expansion." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="870" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-MED-C12" value="«testCase» MED-C12-EV&#10;Method: A/T — planned&#10;Maintain requirement-to-test/evidence traceability and approved entry/exit criteria; no physical or clinical acceptance inferred from simulation." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="870" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-MED-C12" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-MED-C12" target="MED-C12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-MED-C12" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-MED-C12" target="MED-C12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-PAT-01" value="«block» control&#10;Asset: PAT&#10;Proposed allocation&#10;CAD: use cases and reinforced hull&#10;External concept baseline: JFXAI4CBS" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4cbs/blob/main/docs/requirements/transferred-platform-concepts.md"><mxGeometry x="30" y="1120" width="350" height="210" as="geometry" /></mxCell><mxCell id="PAT-01" value="«requirement» PAT-01&#10;Coastal and river mission&#10;SHALL define patrol, community access, supervised emergency transport and handover scenarios within a validated coastal/river envelope.&#10;External concept baseline: JFXAI4CBS" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4cbs/blob/main/docs/requirements/transferred-platform-concepts.md"><mxGeometry x="550" y="1120" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-PAT-01" value="«testCase» PAT-01-EV&#10;Method: A/D — planned&#10;Approve mission and envelope; demonstrate a representative supervised dispatch/transport/handover scenario.&#10;External concept baseline: JFXAI4CBS" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4cbs/blob/main/docs/requirements/transferred-platform-concepts.md"><mxGeometry x="1220" y="1120" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-PAT-01" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-PAT-01" target="PAT-01"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-PAT-01" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-PAT-01" target="PAT-01"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-PAT-02" value="«block» propulsion&#10;Asset: PAT&#10;Proposed allocation&#10;CAD: twin outboards; fuel/electric hybrid label&#10;External concept baseline: JFXAI4CBS" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4cbs/blob/main/docs/requirements/transferred-platform-concepts.md"><mxGeometry x="30" y="1370" width="350" height="210" as="geometry" /></mxCell><mxCell id="PAT-02" value="«requirement» PAT-02&#10;Twin outboard arrangement&#10;SHALL define the depicted twin-outboard propulsion arrangement and assess selected fuel/electric/hybrid alternatives without assuming simultaneous implementation.&#10;External concept baseline: JFXAI4CBS" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4cbs/blob/main/docs/requirements/transferred-platform-concepts.md"><mxGeometry x="550" y="1370" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-PAT-02" value="«testCase» PAT-02-EV&#10;Method: A/T — planned&#10;Compare selected drive with resistance/energy budget; test steering and local stop for its approved configuration.&#10;External concept baseline: JFXAI4CBS" style="rounde