thub.com/robotics-intelligent-systems/jfxai4cbs/blob/main/docs/requirements/transferred-platform-concepts.md"><mxGeometry x="1220" y="1120" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-PAT-07" value="«satisfy»&#10;proposed" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="design-PAT-07" target="PAT-07"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="verify-PAT-07" value="«verify»&#10;planned" style="edgeStyle=orthogonalEdgeStyle;html=0;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="test-PAT-07" target="PAT-07"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="design-MOD-01" value="«block» mission&#10;Asset: MOD&#10;Proposed allocation&#10;CAD: medical facilities and use cases" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="1370" width="350" height="210" as="geometry" /></mxCell><mxCell id="MOD-01" value="«requirement» MOD-01&#10;Configurable vessel mission&#10;SHALL define consultation, emergency support, laboratory, vaccination and telemedicine configurations with approved occupancy and crew roles." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="550" y="1370" width="500" height="210" as="geometry" /></mxCell><mxCell id="test-MOD-01" value="«testCase» MOD-01-EV&#10;Method: I/D — planned&#10;Review configuration/CONOPS; demonstrate workflow and boarding for a selected configuration." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#64748b;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="1220" y="1370" width="350" height="210" as="geometry" /></mxCell><mxCell id="satisfy-MOD-