  <diagram id="PAT-1" name="01 — Scope and CAD baseline">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenTwin — Medical Patrol Boat Requirements&lt;br&gt;&lt;b&gt;01 — Scope and CAD baseline&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=18;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="78" />
        </mxCell>
        <mxCell id="footer" value="PROPOSED CONCEPT BASELINE • CAD illustration is not validated geometry • I: inspection · A: analysis · D: demonstration · T: test • Clinical/physical acceptance evidence pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=12;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="source" value="&lt;b&gt;CAD source&lt;/b&gt;&lt;br&gt;MBSE/CAD/medical-patrol-boat-concept.jpg&lt;br&gt;&lt;br&gt;Source revision and hashes: docs/requirements/cad-source-baseline.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="scope" value="&lt;b&gt;Illustrated system boundary&lt;/b&gt;&lt;br&gt;Small coastal/river patrol craft with twin outboards, patient compartment, modular working deck, roof PV and communications. No helipad, surgery or ICU is shown." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="status" value="&lt;b&gt;Baseline status&lt;/b&gt;&lt;br&gt;Proposed requirements. Named owner roles are recommendations; people, dates and quantitative budgets need assignment. No test completion, clinical capability or certification is claimed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="roles" value="&lt;b&gt;Stakeholders / responsibility&lt;/b&gt;&lt;br&gt;Skipper, crew, clinical staff, patient/escort, EMS coordinator, maintainer, naval architect, clinical governance and data/privacy owners.&lt;br&gt;CONOPS: configure → inspect → dispatch/support → transfer/handover → recover/maintain." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="common" value="&lt;b&gt;Requirements allocation&lt;/b&gt;&lt;br&gt;Allocate MED-C01 through MED-C12 alongside asset-specific requirements. Common evidence needs a recorded applicability decision per configuration.&lt;br&gt;Traceability: cad-requirements-traceability.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="limits" value="&lt;b&gt;Concept limitations&lt;/b&gt;&lt;br&gt;Dashboard speeds, percentages, coordinates and status are examples. Quantitative design and operating limits remain TBD. CAD labels do not establish patent clearance, environmental performance or medical/aviation approval." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="380" width="500" height="235" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="PAT-2" name="02 — High-level requirements 1–7">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenTwin — Medical Patrol Boat Requirements&lt;br&gt;&lt;b&gt;02 — High-level requirements 1–7&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=18;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="78" />
        </mxCell>
        <mxCell id="footer" value="PROPOSED CONCEPT BASELINE • CAD illustration is not validated geometry • I: inspection · A: analysis · D: demonstration · T: test • Clinical/physical acceptance evidence pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=12;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="PAT-01" value="&lt;b&gt;PAT-01 — Coastal and river mission&lt;/b&gt;&lt;br&gt;SHALL define patrol, community access, supervised emergency transport and handover scenarios within a validated coastal/river envelope.&lt;br&gt;&lt;br&gt;&lt;b&gt;A/D · Acceptance&lt;/b&gt;&lt;br&gt;Approve mission and envelope; demonstrate a representative supervised dispatch/transport/handover scenario." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="PAT-02" value="&lt;b&gt;PAT-02 — Twin outboard arrangement&lt;/b&gt;&lt;br&gt;SHALL define the depicted twin-outboard propulsion arrangement and assess selected fuel/electric/hybrid alternatives without assuming simultaneous implementation.&lt;br&gt;&lt;br&gt;&lt;b&gt;A/T · Acceptance&lt;/b&gt;&lt;br&gt;Compare selected drive with resistance/energy budget; test steering and local stop for its approved configuration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="PAT-03" value="&lt;b&gt;PAT-03 — Patient compartment&lt;/b&gt;&lt;br&gt;SHALL provide an arranged patient area for stretcher retention, selected monitoring and supervised telemedicine with accessible equipment.&lt;br&gt;&lt;br&gt;&lt;b&gt;I/D · Acceptance&lt;/b&gt;&lt;br&gt;Inspect stretcher/equipment access and demonstrate transfer and monitoring workflow for approved occupancy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="PAT-04" value="&lt;b&gt;PAT-04 — Modular working deck&lt;/b&gt;&lt;br&gt;SHALL define deck equipment/rescue/cargo mounts, retention and clear working/boarding routes with controlled mass/CG.&lt;br&gt;&lt;br&gt;&lt;b&gt;A/I · Acceptance&lt;/b&gt;&lt;br&gt;Review load/mount records and inspect access for each selected rescue/cargo configuration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="PAT-05" value="&lt;b&gt;PAT-05 — Solar and protected power&lt;/b&gt;&lt;br&gt;SHALL define roof PV and its protected conversion interface to the selected vessel energy system.&lt;br&gt;&lt;br&gt;&lt;b&gt;A/T · Acceptance&lt;/b&gt;&lt;br&gt;Approve mounting/shading and power budget; test isolated charging and essential-load priority." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="PAT-06" value="&lt;b&gt;PAT-06 — Navigation and communications&lt;/b&gt;&lt;br&gt;SHALL integrate selected GPS/GNSS, AIS, radar/cameras, VHF and optional cellular/satellite communications with local helm indication.&lt;br&gt;&lt;br&gt;&lt;b&gt;T · Acceptance&lt;/b&gt;&lt;br&gt;Replay sensor/link faults; verify validity, operator status and approved degraded response." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="PAT-07" value="&lt;b&gt;PAT-07 — Water and waste&lt;/b&gt;&lt;br&gt;SHALL provide separate fresh, grey and black water circuits/tanks with service access and approved capacities.&lt;br&gt;&lt;br&gt;&lt;b&gt;I/T · Acceptance&lt;/b&gt;&lt;br&gt;Inspect independent circuits and demonstrate leakage/level response against the approved mission budgets." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="640" width="500" height="235" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="PAT-3" name="03 — Logical architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
