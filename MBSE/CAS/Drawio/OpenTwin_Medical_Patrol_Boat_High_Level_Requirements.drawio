        <mxCell id="title" value="OpenTwin — Medical Patrol Boat Requirements&lt;br&gt;&lt;b&gt;03 — Logical architecture&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=18;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="78" />
        </mxCell>
        <mxCell id="footer" value="PROPOSED CONCEPT BASELINE • CAD illustration is not validated geometry • I: inspection · A: analysis · D: demonstration · T: test • Clinical/physical acceptance evidence pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=12;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="hull" value="&lt;b&gt;Naval platform&lt;/b&gt;&lt;br&gt;Hull/deck, compartmentation, loading, stability and mounts&lt;br&gt;&lt;br&gt;Allocation: MED-C01, MED-C02" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="propulsion" value="&lt;b&gt;Marine propulsion&lt;/b&gt;&lt;br&gt;Selected drive, steering, local stop and service access&lt;br&gt;&lt;br&gt;Allocation: PAT-02" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="energy" value="&lt;b&gt;Energy and power&lt;/b&gt;&lt;br&gt;Selected sources, PV, protected distribution and reserves&lt;br&gt;&lt;br&gt;Allocation: PAT-05, MED-C04" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="medical" value="&lt;b&gt;Medical facilities / utilities&lt;/b&gt;&lt;br&gt;Configured equipment, patient access, hygiene, water/waste and essential services&lt;br&gt;&lt;br&gt;Allocation: PAT-03, PAT-07, MED-C03, MED-C05" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="control" value="&lt;b&gt;Local helm and authority&lt;/b&gt;&lt;br&gt;Navigation, operator state and clinical/dispatch responsibility boundaries&lt;br&gt;&lt;br&gt;Allocation: PAT-01, PAT-06, MED-C11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="mission" value="&lt;b&gt;Mission / transfer / logistics&lt;/b&gt;&lt;br&gt;Modular working deck, rescue/cargo and supervised boarding/handover; no illustrated aviation interface&lt;br&gt;&lt;br&gt;Allocation: PAT-04" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="edge" value="&lt;b&gt;OpenTwin operational edge&lt;/b&gt;&lt;br&gt;Asset/configuration state, quality, buffering and maintenance; no unrestricted clinical payloads&lt;br&gt;&lt;br&gt;Allocation: MED-C09, MED-C10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="640" width="500" height="235" />
        </mxCell>
        <mxCell id="clinical" value="&lt;b&gt;Protected clinical integration&lt;/b&gt;&lt;br&gt;Authorized HIS/FHIR and selected imaging/telemedicine; clinical records/audit with separate access control&lt;br&gt;&lt;br&gt;Allocation: MED-C07, MED-C08" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="640" width="500" height="235" />
        </mxCell>
        <mxCell id="configuration" value="&lt;b&gt;Configuration and simulation&lt;/b&gt;&lt;br&gt;Module contracts, budgets, as-built, model versions and planned evidence&lt;br&gt;&lt;br&gt;Allocation: MED-C06, MED-C12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="640" width="500" height="235" />
        </mxCell>
        <mxCell id="e0" value="mount" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748b;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="hull" target="propulsion">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" value="power" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="energy" target="propulsion">
          <mxGeometry as="geometry" relative="1">
