              <mxPoint x="1320" y="108" />
              <mxPoint x="800" y="108" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" value="roles" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748b;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="medical" target="control">
          <mxGeometry as="geometry" relative="1" />
