  </diagram>
  <diagram id="PAT-4" name="04 — Interfaces and modes">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenTwin — Medical Patrol Boat Requirements&lt;br&gt;&lt;b&gt;04 — Interfaces and modes&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=18;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="78" />
        </mxCell>
        <mxCell id="footer" value="PROPOSED CONCEPT BASELINE • CAD illustration is not validated geometry • I: inspection · A: analysis · D: demonstration · T: test • Clinical/physical acceptance evidence pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=12;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="mech" value="&lt;b&gt;Mechanical / patient-transfer contract&lt;/b&gt;&lt;br&gt;Mounts, loads, mass/CG, retention, handling, access/egress and maintenance. For MOD/SHIP: separate aircraft and boat interface designs.&lt;br&gt;Capacity/geometry: TBD by asset and configuration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="power" value="&lt;b&gt;Power / fluid contract&lt;/b&gt;&lt;br&gt;Selected bus ratings/connectors, isolation, reserve/essential loads, water/waste and HVAC interfaces.&lt;br&gt;Medical equipment integration requires its own verification and service/calibration records." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="data" value="&lt;b&gt;Clinical vs operational data&lt;/b&gt;&lt;br&gt;Operational: asset_id, configuration_id, mission_id, mode, location, energy, health/faults, timestamp, units, quality and source.&lt;br&gt;Clinical: authorized encounter/record links behind a dedicated access boundary." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="modes" value="&lt;b&gt;Baseline operating contexts&lt;/b&gt;&lt;br&gt;SAFE / ISOLATED&lt;br&gt;MANUAL NAVIGATION&lt;br&gt;PATIENT BOARDING / HANDOVER&lt;br&gt;SUPERVISED TRANSPORT&lt;br&gt;DOCKED / OUTREACH&lt;br&gt;DEGRADED / RECOVERY&lt;br&gt;MAINTENANCE&lt;br&gt;Clinical work and vessel modes are coordinated but not a single autonomous controller." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="guards" value="&lt;b&gt;Guards and fault responses&lt;/b&gt;&lt;br&gt;Approve tables for patient/equipment retention, personnel access, source isolation, stale data and local control. Transfers and handling require authorized entry conditions. Connectivity loss follows approved local/degraded workflows." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="requests" value="&lt;b&gt;Command / authority contract&lt;/b&gt;&lt;br&gt;Sender identity, role, mode, expected revision, expiration and acknowledgement. Reject unsafe or unauthorized requests. Document marine control, clinical decisions and dispatch authority independently." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="380" width="500" height="235" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="PAT-5" name="05 — Verification, budgets and release">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenTwin — Medical Patrol Boat Requirements&lt;br&gt;&lt;b&gt;05 — Verification, budgets and release&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=18;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="78" />
        </mxCell>
        <mxCell id="footer" value="PROPOSED CONCEPT BASELINE • CAD illustration is not validated geometry • I: inspection · A: analysis · D: demonstration · T: test • Clinical/physical acceptance evidence pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=12;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="navbudget" value="&lt;b&gt;Naval / handling budgets — TBD&lt;/b&gt;&lt;br&gt;Dimensions, draft/freeboard, mass/CG, payload/occupancy, stability, structural loads, speed/endurance, environmental and boarding/transfer limits.&lt;br&gt;Helipad/boat budgets apply only to selected MOD/SHIP interfaces." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="medbudget" value="&lt;b&gt;Medical / power / data budgets — TBD&lt;/b&gt;&lt;br&gt;Approved clinical scope, equipment, staff, utility quality/capacity, cold chain where selected, energy/reserve, timing/accuracy/staleness and recovery requirements." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="vv" value="&lt;b&gt;Verification sequence&lt;/b&gt;&lt;br&gt;Requirements and layout review → naval/utility analysis → model validation → bench/SIL/HIL fault cases → subsystem inspections → controlled vessel trials → supervised mission demonstration.&lt;br&gt;Clinical and aviation acceptance are separate workstreams." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="trace" value="&lt;b&gt;Traceability and evidence&lt;/b&gt;&lt;br&gt;Need → requirement → CAD callout/derived rationale → allocated design element → acceptance method → planned evidence ID → configuration.&lt;br&gt;CSV includes roles, criteria and evidence-pending status." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;Baseline exit&lt;/b&gt;&lt;br&gt;Approve CONOPS and responsibilities; assign people/dates; fix critical budgets and measurable acceptance limits; approve interfaces, hazards and fault/mode tables; establish test and evidence records." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="maturity" value="&lt;b&gt;Preserved references / maturity&lt;/b&gt;&lt;br&gt;D3Web.drawio remains a d3web/Drools class reference, not naval/clinical requirements evidence. Mermaid describes proposed architecture. No CAD image or illustrative dashboard proves acceptance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="380" width="500" height="235" />
