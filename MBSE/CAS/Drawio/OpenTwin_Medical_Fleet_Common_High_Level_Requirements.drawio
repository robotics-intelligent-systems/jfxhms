  <diagram id="COM-1" name="01 — Scope and CAD baseline">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenTwin Medical Fleet — Common Requirements&lt;br&gt;&lt;b&gt;01 — Scope and CAD baseline&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=18;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="78" />
        </mxCell>
        <mxCell id="footer" value="PROPOSED CONCEPT BASELINE • CAD illustration is not validated geometry • I: inspection · A: analysis · D: demonstration · T: test • Clinical/physical acceptance evidence pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=12;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="source" value="&lt;b&gt;CAD source&lt;/b&gt;&lt;br&gt;All three MBSE/CAD concepts&lt;br&gt;&lt;br&gt;Source revision and hashes: docs/requirements/cad-source-baseline.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="scope" value="&lt;b&gt;Illustrated system boundary&lt;/b&gt;&lt;br&gt;Shared proposed requirements allocated to all three vessel concepts. No common speed, capacity, medical scope or helipad is implied." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="status" value="&lt;b&gt;Baseline status&lt;/b&gt;&lt;br&gt;Proposed requirements. Named owner roles are recommendations; people, dates and quantitative budgets need assignment. No test completion, clinical capability or certification is claimed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="roles" value="&lt;b&gt;Stakeholders / responsibility&lt;/b&gt;&lt;br&gt;Skipper, crew, clinical staff, patient/escort, EMS coordinator, maintainer, naval architect, clinical governance and data/privacy owners.&lt;br&gt;CONOPS: configure → inspect → dispatch/support → transfer/handover → recover/maintain." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="common" value="&lt;b&gt;Requirements allocation&lt;/b&gt;&lt;br&gt;MED-C01 through MED-C12 are shared obligations; verify their application to each installed asset.&lt;br&gt;Traceability: cad-requirements-traceability.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="limits" value="&lt;b&gt;Concept limitations&lt;/b&gt;&lt;br&gt;Dashboard speeds, percentages, coordinates and status are examples. Quantitative design and operating limits remain TBD. CAD labels do not establish patent clearance, environmental performance or medical/aviation approval." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="380" width="500" height="235" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="COM-2" name="02 — High-level requirements 1–9">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenTwin Medical Fleet — Common Requirements&lt;br&gt;&lt;b&gt;02 — High-level requirements 1–9&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=18;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="78" />
        </mxCell>
        <mxCell id="footer" value="PROPOSED CONCEPT BASELINE • CAD illustration is not validated geometry • I: inspection · A: analysis · D: demonstration · T: test • Clinical/physical acceptance evidence pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=12;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="MED-C01" value="&lt;b&gt;MED-C01 — Naval loading and stability&lt;/b&gt;&lt;br&gt;SHALL define displacement, draft, freeboard, mass/CG and stability for each approved occupancy and module loading case.&lt;br&gt;&lt;br&gt;&lt;b&gt;A · Acceptance&lt;/b&gt;&lt;br&gt;Approved loading-case analysis against preselected naval criteria; no dimensions inferred from the illustration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="MED-C02" value="&lt;b&gt;MED-C02 — Structure and watertightness&lt;/b&gt;&lt;br&gt;SHALL define compartmentation, penetrations, structural load paths, module attachments, drainage and corrosion protection.&lt;br&gt;&lt;br&gt;&lt;b&gt;A/I · Acceptance&lt;/b&gt;&lt;br&gt;Inspect arrangement and review structural/penetration/load evidence for each selected configuration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="MED-C03" value="&lt;b&gt;MED-C03 — Patient access and transfer&lt;/b&gt;&lt;br&gt;SHALL define secure stretcher/equipment retention, boarding, handling, access and emergency egress for the approved occupancy.&lt;br&gt;&lt;br&gt;&lt;b&gt;I/D · Acceptance&lt;/b&gt;&lt;br&gt;Demonstrate representative boarding, securing and egress against an approved human-factors plan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="MED-C04" value="&lt;b&gt;MED-C04 — Essential energy&lt;/b&gt;&lt;br&gt;SHALL define protected power, reserve and degraded-load priorities for navigation, medical support, communications and alarms.&lt;br&gt;&lt;br&gt;&lt;b&gt;A/T · Acceptance&lt;/b&gt;&lt;br&gt;Review mission energy budget; inject source loss and verify approved essential-load and shutdown behavior." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="MED-C05" value="&lt;b&gt;MED-C05 — Medical environment and utilities&lt;/b&gt;&lt;br&gt;SHALL define clean/dirty flows, ventilation, potable/process water, waste and equipment-service access for the selected medical mission.&lt;br&gt;&lt;br&gt;&lt;b&gt;A/I · Acceptance&lt;/b&gt;&lt;br&gt;Approve layout, segregation, utility budgets and maintainability criteria before installation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="MED-C06" value="&lt;b&gt;MED-C06 — Module interfaces&lt;/b&gt;&lt;br&gt;SHALL maintain versioned mounting, mass/CG, power/fluid, command/data and service contracts with compatibility and license records.&lt;br&gt;&lt;br&gt;&lt;b&gt;I · Acceptance&lt;/b&gt;&lt;br&gt;Review a module contract and its approved installation/removal plan; identify all affected loading and service budgets." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="MED-C07" value="&lt;b&gt;MED-C07 — Interoperability scope&lt;/b&gt;&lt;br&gt;SHALL select clinical exchange versions/profiles and terminology; isolate HIS/FHIR and optional imaging adapters behind validated interfaces.&lt;br&gt;&lt;br&gt;&lt;b&gt;T/I · Acceptance&lt;/b&gt;&lt;br&gt;Test representative exchanges against selected profiles and authorization rules; record incompatible or invalid inputs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="640" width="500" height="235" />
        </mxCell>
        <mxCell id="MED-C08" value="&lt;b&gt;MED-C08 — Clinical privacy boundary&lt;/b&gt;&lt;br&gt;SHALL keep clinical records and access audit under dedicated governance; use authorized minimal links in ordinary asset/mission telemetry.&lt;br&gt;&lt;br&gt;&lt;b&gt;T · Acceptance&lt;/b&gt;&lt;br&gt;Attempt unauthorized clinical access/export through twin and event APIs; deny disclosure and audit authorized access." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="640" width="500" height="235" />
        </mxCell>
        <mxCell id="MED-C09" value="&lt;b&gt;MED-C09 — OpenTwin asset data&lt;/b&gt;&lt;br&gt;SHALL publish asset/configuration identity, mode, location, energy, equipment readiness, faults and maintenance with timestamps, units and quality.&lt;br&gt;&lt;br&gt;&lt;b&gt;T · Acceptance&lt;/b&gt;&lt;br&gt;Replay valid, stale and reconnect datasets; verify field provenance, configuration and approved freshness/error criteria." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="640" width="500" height="235" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="COM-3" name="02 — High-level requirements 10–12">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenTwin Medical Fleet — Common Requirements&lt;br&gt;&lt;b&gt;02 — High-level requirements 10–12&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=18;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="78" />
        </mxCell>
        <mxCell id="footer" value="PROPOSED CONCEPT BASELINE • CAD illustration is not validated geometry • I: inspection · A: analysis · D: demonstration · T: test • Clinical/physical acceptance evidence pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=12;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="MED-C10" value="&lt;b&gt;MED-C10 — Communications resilience&lt;/b&gt;&lt;br&gt;SHALL provide selected marine/local communications and authorized remote monitoring with buffering and defined disconnected workflows.&lt;br&gt;&lt;br&gt;&lt;b&gt;T · Acceptance&lt;/b&gt;&lt;br&gt;Demonstrate WAN loss, reconnection and conflict handling while essential local monitoring/control remains available." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="MED-C11" value="&lt;b&gt;MED-C11 — Local authority and AI governance&lt;/b&gt;&lt;br&gt;SHALL retain validated local vessel control and qualified clinical/dispatch authority; record model, input provenance and human review for AI proposals.&lt;br&gt;&lt;br&gt;&lt;b&gt;T/I · Acceptance&lt;/b&gt;&lt;br&gt;Block unreviewed consequential proposals; verify local safe stop/control during cloud/AI loss and retrieve reviewed decision evidence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="MED-C12" value="&lt;b&gt;MED-C12 — Verification and envelope&lt;/b&gt;&lt;br&gt;SHALL approve mission/environment, device/calibration and recovery criteria; validate models and staged trials before envelope expansion.&lt;br&gt;&lt;br&gt;&lt;b&gt;A/T · Acceptance&lt;/b&gt;&lt;br&gt;Maintain requirement-to-test/evidence traceability and approved entry/exit criteria; no physical or clinical acceptance inferred from simulation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="COM-4" name="03 — Logical architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenTwin Medical Fleet — Common Requirements&lt;br&gt;&lt;b&gt;03 — Logical architecture&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=18;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="78" />
        </mxCell>
        <mxCell id="footer" value="PROPOSED CONCEPT BASELINE • CAD illustration is not validated geometry • I: inspection · A: analysis · D: demonstration · T: test • Clinical/physical acceptance evidence pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=12;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="hull" value="&lt;b&gt;Naval platform&lt;/b&gt;&lt;br&gt;Hull/deck, compartmentation, loading, stability and mounts&lt;br&gt;&lt;br&gt;Allocation: MED-C01, MED-C02" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="propulsion" value="&lt;b&gt;Marine propulsion&lt;/b&gt;&lt;br&gt;Selected drive, steering, local stop and service access; acceptance is asset-specific&lt;br&gt;&lt;br&gt;Allocation: Detailed allocation at asset baseline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="energy" value="&lt;b&gt;Energy and power&lt;/b&gt;&lt;br&gt;Selected sources, PV, protected distribution and reserves&lt;br&gt;&lt;br&gt;Allocation: MED-C04" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="medical" value="&lt;b&gt;Medical facilities / utilities&lt;/b&gt;&lt;br&gt;Configured equipment, patient access, hygiene, water/waste and essential services&lt;br&gt;&lt;br&gt;Allocation: MED-C03, MED-C05" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="control" value="&lt;b&gt;Local helm and authority&lt;/b&gt;&lt;br&gt;Navigation, operator state and clinical/dispatch responsibility boundaries&lt;br&gt;&lt;br&gt;Allocation: MED-C11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="mission" value="&lt;b&gt;Mission / transfer / logistics&lt;/b&gt;&lt;br&gt;Patient/cargo/boat interfaces; aviation interface only for MOD/SHIP&lt;br&gt;&lt;br&gt;Allocation: Detailed allocation at asset baseline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="edge" value="&lt;b&gt;OpenTwin operational edge&lt;/b&gt;&lt;br&gt;Asset/configuration state, quality, buffering and maintenance; no unrestricted clinical payloads&lt;br&gt;&lt;br&gt;Allocation: MED-C09, MED-C10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="640" width="500" height="235" />
        </mxCell>
        <mxCell id="clinical" value="&lt;b&gt;Protected clinical integration&lt;/b&gt;&lt;br&gt;Authorized HIS/FHIR and selected imaging/telemedicine; clinical records/audit with separate access control&lt;br&gt;&lt;br&gt;Allocation: MED-C07, MED-C08" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="640" width="500" height="235" />
        </mxCell>
        <mxCell id="configuration" value="&lt;b&gt;Configuration and simulation&lt;/b&gt;&lt;br&gt;Module contracts, budgets, as-built, model versions and planned evidence&lt;br&gt;&lt;br&gt;Allocation: MED-C06, MED-C12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="640" width="500" height="235" />
        </mxCell>
        <mxCell id="e0" value="mount" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748b;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="hull" target="propulsion">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e1" value="power" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748b;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="energy" target="propulsion">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1320" y="108" />
              <mxPoint x="800" y="108" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" value="roles" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748b;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="medical" target="control">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e3" value="coord." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748b;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="control" target="mission">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e4" value="link" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748b;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="edge" target="clinical">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e5" value="versions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748b;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="clinical" target="configuration">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="COM-5" name="04 — Interfaces and modes">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenTwin Medical Fleet — Common Requirements&lt;br&gt;&lt;b&gt;04 — Interfaces and modes&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=18;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="78" />
        </mxCell>
        <mxCell id="footer" value="PROPOSED CONCEPT BASELINE • CAD illustration is not validated geometry • I: inspection · A: analysis · D: demonstration · T: test • Clinical/physical acceptance evidence pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=12;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="mech" value="&lt;b&gt;Mechanical / patient-transfer contract&lt;/b&gt;&lt;br&gt;Mounts, loads, mass/CG, retention, handling, access/egress and maintenance. For MOD/SHIP: separate aircraft and boat interface designs.&lt;br&gt;Capacity/geometry: TBD by asset and configuration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="power" value="&lt;b&gt;Power / fluid contract&lt;/b&gt;&lt;br&gt;Selected bus ratings/connectors, isolation, reserve/essential loads, water/waste and HVAC interfaces.&lt;br&gt;Medical equipment integration requires its own verification and service/calibration records." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="data" value="&lt;b&gt;Clinical vs operational data&lt;/b&gt;&lt;br&gt;Operational: asset_id, configuration_id, mission_id, mode, location, energy, health/faults, timestamp, units, quality and source.&lt;br&gt;Clinical: authorized encounter/record links behind a dedicated access boundary." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="modes" value="&lt;b&gt;Baseline operating contexts&lt;/b&gt;&lt;br&gt;SAFE / ISOLATED&lt;br&gt;SUPERVISED MISSION&lt;br&gt;DEGRADED / RECOVERY&lt;br&gt;MAINTENANCE&lt;br&gt;Clinical work and vessel modes are coordinated but not a single autonomous controller." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="guards" value="&lt;b&gt;Guards and fault responses&lt;/b&gt;&lt;br&gt;Approve tables for patient/equipment retention, personnel access, source isolation, stale data and local control. Transfers and handling require authorized entry conditions. Connectivity loss follows approved local/degraded workflows." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="requests" value="&lt;b&gt;Command / authority contract&lt;/b&gt;&lt;br&gt;Sender identity, role, mode, expected revision, expiration and acknowledgement. Reject unsafe or unauthorized requests. Document marine control, clinical decisions and dispatch authority independently." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="380" width="500" height="235" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="COM-6" name="05 — Verification, budgets and release">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenTwin Medical Fleet — Common Requirements&lt;br&gt;&lt;b&gt;05 — Verification, budgets and release&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=18;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="78" />
        </mxCell>
        <mxCell id="footer" value="PROPOSED CONCEPT BASELINE • CAD illustration is not validated geometry • I: inspection · A: analysis · D: demonstration · T: test • Clinical/physical acceptance evidence pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=12;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="navbudget" value="&lt;b&gt;Naval / handling budgets — TBD&lt;/b&gt;&lt;br&gt;Dimensions, draft/freeboard, mass/CG, payload/occupancy, stability, structural loads, speed/endurance, environmental and boarding/transfer limits.&lt;br&gt;Helipad/boat budgets apply only to selected MOD/SHIP interfaces." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="medbudget" value="&lt;b&gt;Medical / power / data budgets — TBD&lt;/b&gt;&lt;br&gt;Approved clinical scope, equipment, staff, utility quality/capacity, cold chain where selected, energy/reserve, timing/accuracy/staleness and recovery requirements." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="vv" value="&lt;b&gt;Verification sequence&lt;/b&gt;&lt;br&gt;Requirements and layout review → naval/utility analysis → model validation → bench/SIL/HIL fault cases → subsystem inspections → controlled vessel trials → supervised mission demonstration.&lt;br&gt;Clinical and aviation acceptance are separate workstreams." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="trace" value="&lt;b&gt;Traceability and evidence&lt;/b&gt;&lt;br&gt;Need → requirement → CAD callout/derived rationale → allocated design element → acceptance method → planned evidence ID → configuration.&lt;br&gt;CSV includes roles, criteria and evidence-pending status." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;Baseline exit&lt;/b&gt;&lt;br&gt;Approve CONOPS and responsibilities; assign people/dates; fix critical budgets and measurable acceptance limits; approve interfaces, hazards and fault/mode tables; establish test and evidence records." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="maturity" value="&lt;b&gt;Preserved references / maturity&lt;/b&gt;&lt;br&gt;D3Web.drawio remains a d3web/Drools class reference, not naval/clinical requirements evidence. Mermaid describes proposed architecture. No CAD image or illustrative dashboard proves acceptance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="380" width="500" height="235" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>