<mxfile host="app.diagrams.net" agent="jfxhms CAD-aligned requirements" version="24.7.17" type="device">
  <diagram id="SHIP-1" name="01 — Scope and CAD baseline">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenTwin — Large Medical Support Ship Requirements&lt;br&gt;&lt;b&gt;01 — Scope and CAD baseline&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=18;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="78" />
        </mxCell>
        <mxCell id="footer" value="PROPOSED CONCEPT BASELINE • CAD illustration is not validated geometry • I: inspection · A: analysis · D: demonstration · T: test • Clinical/physical acceptance evidence pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=12;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="source" value="&lt;b&gt;CAD source&lt;/b&gt;&lt;br&gt;MBSE/CAD/large-medical-support-ship-concept.jpg&lt;br&gt;&lt;br&gt;Source revision and hashes: docs/requirements/cad-source-baseline.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="scope" value="&lt;b&gt;Illustrated system boundary&lt;/b&gt;&lt;br&gt;Large support ship with modular advanced-care facilities, accommodation, logistics/cargo, bridge, helipad/support boats and utility plant. Clinical services are candidates requiring separate approval." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="status" value="&lt;b&gt;Baseline status&lt;/b&gt;&lt;br&gt;Proposed requirements. Named owner roles are recommendations; people, dates and quantitative budgets need assignment. No test completion, clinical capability or certification is claimed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="roles" value="&lt;b&gt;Stakeholders / responsibility&lt;/b&gt;&lt;br&gt;Skipper, crew, clinical staff, patient/escort, EMS coordinator, maintainer, naval architect, clinical governance and data/privacy owners.&lt;br&gt;CONOPS: configure → inspect → dispatch/support → transfer/handover → recover/maintain." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="common" value="&lt;b&gt;Requirements allocation&lt;/b&gt;&lt;br&gt;Allocate MED-C01 through MED-C12 alongside asset-specific requirements. Common evidence needs a recorded applicability decision per configuration.&lt;br&gt;Traceability: cad-requirements-traceability.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="limits" value="&lt;b&gt;Concept limitations&lt;/b&gt;&lt;br&gt;Dashboard speeds, percentages, coordinates and status are examples. Quantitative design and operating limits remain TBD. CAD labels do not establish patent clearance, environmental performance or medical/aviation approval." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="380" width="500" height="235" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="SHIP-2" name="02 — High-level requirements 1–9">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="OpenTwin — Large Medical Support Ship Requirements&lt;br&gt;&lt;b&gt;02 — High-level requirements 1–9&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=18;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="78" />
        </mxCell>
        <mxCell id="footer" value="PROPOSED CONCEPT BASELINE • CAD illustration is not validated geometry • I: inspection · A: analysis · D: demonstration · T: test • Clinical/physical acceptance evidence pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#64748b;fontFamily=Helvetica;fontSize=12;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1540" height="42" />
        </mxCell>
        <mxCell id="SHIP-01" value="&lt;b&gt;SHIP-01 — Large support-ship mission&lt;/b&gt;&lt;br&gt;SHALL define humanitarian, disaster-response and outreach configurations with passenger/patient/crew and logistics loading records.&lt;br&gt;&lt;br&gt;&lt;b&gt;A/I · Acceptance&lt;/b&gt;&lt;br&gt;Approve mission/configuration and occupancy/loading budgets; inspect arrangement and access for selected roles." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="SHIP-02" value="&lt;b&gt;SHIP-02 — Advanced clinical facilities&lt;/b&gt;&lt;br&gt;SHALL evaluate illustrated emergency, surgery, ICU, laboratory, pharmacy, maternity and telemedicine facilities as separately approved clinical modules.&lt;br&gt;&lt;br&gt;&lt;b&gt;A/I · Acceptance&lt;/b&gt;&lt;br&gt;Approve clinical scope, staff/equipment, layout, utilities and qualification evidence for each activated service." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="SHIP-03" value="&lt;b&gt;SHIP-03 — Patient accommodation&lt;/b&gt;&lt;br&gt;SHALL define configurable accommodation, transfers, accessibility and evacuation routes matched to approved occupancy and clinical scope.&lt;br&gt;&lt;br&gt;&lt;b&gt;I/D · Acceptance&lt;/b&gt;&lt;br&gt;Inspect arrangement and demonstrate representative transfer/egress against a clinically reviewed plan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="120" width="500" height="235" />
        </mxCell>
        <mxCell id="SHIP-04" value="&lt;b&gt;SHIP-04 — Bridge and command&lt;/b&gt;&lt;br&gt;SHALL provide local navigation, communications and mission coordination under defined bridge and clinical responsibilities.&lt;br&gt;&lt;br&gt;&lt;b&gt;T/D · Acceptance&lt;/b&gt;&lt;br&gt;Demonstrate operational coordination and control continuity under sensor/link faults using an approved responsibility table." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="SHIP-05" value="&lt;b&gt;SHIP-05 — Logistics and cargo&lt;/b&gt;&lt;br&gt;SHALL define modular cargo, supplies and vehicle/container interfaces with retention, loading records and cold-chain/expiry controls where applicable.&lt;br&gt;&lt;br&gt;&lt;b&gt;A/I · Acceptance&lt;/b&gt;&lt;br&gt;Verify cargo mass/CG, retention and records; inspect cold-chain/expiry acceptance for selected supplies." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="SHIP-06" value="&lt;b&gt;SHIP-06 — Helipad and support boats&lt;/b&gt;&lt;br&gt;SHALL engineer independent helipad and boat handling/transfer interfaces with approved loads, access, exclusion zones and operating limits.&lt;br&gt;&lt;br&gt;&lt;b&gt;A/D · Acceptance&lt;/b&gt;&lt;br&gt;Approve aircraft/boat compatibility and handling plans; demonstrate only operations whose entry criteria are satisfied." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="380" width="500" height="235" />
        </mxCell>
        <mxCell id="SHIP-07" value="&lt;b&gt;SHIP-07 — Energy variants and renewables&lt;/b&gt;&lt;br&gt;SHALL assess illustrated LNG/biofuel/electric-ready propulsion alternatives and PV against mission demand and essential reserves.&lt;br&gt;&lt;br&gt;&lt;b&gt;A/T · Acceptance&lt;/b&gt;&lt;br&gt;Record selected sources and their mass/thermal/energy impacts; verify reserve and fault behavior without claiming all variants are installed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="640" width="500" height="235" />
        </mxCell>
        <mxCell id="SHIP-08" value="&lt;b&gt;SHIP-08 — Water and waste plant&lt;/b&gt;&lt;br&gt;SHALL define filtration/desalination/treatment candidates and separate potable, process and waste interfaces for mission/hotel/clinical demand.&lt;br&gt;&lt;br&gt;&lt;b&gt;A/T · Acceptance&lt;/b&gt;&lt;br&gt;Approve source/quality/capacity and discharge criteria; verify selected process and service access against the defined specification." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="640" width="500" height="235" />
        </mxCell>
        <mxCell id="SHIP-09" value="&lt;b&gt;SHIP-09 — Clinical and mission exchange&lt;/b&gt;&lt;br&gt;SHALL select authorized FHIR, optional DICOM imaging and mission/geospatial adapters with explicit versions, profiles and permissions.&lt;br&gt;&lt;br&gt;&lt;b&gt;T · Acceptance&lt;/b&gt;&lt;br&gt;Run authorized synthetic clinical/imaging/mission exchange tests; verify invalid-profile rejection and privacy separation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Helvetica;fontSize=15;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1070" y="640" width="500" height="235" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="SHIP-3" name="03 — Logical architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
