        <mxCell id="title" value="OpenTwin — Large Medical Support Ship Requirements&lt;br&gt;&lt;b&gt;03 — Logical architecture&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Helvetica;fontSize=18;fontColor=#14263d;arcSize=10;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1540" height="78" />
